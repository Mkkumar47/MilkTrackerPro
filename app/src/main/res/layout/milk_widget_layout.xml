<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="MilkTrack Pro"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Today"
            android:textColor="#94A3B8"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#334155"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp" />

    <!-- Summary Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <!-- Monthly Expense -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CURRENT MONTH BILL"
            android:textColor="#94A3B8"
            android:textSize="9dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_month_expense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textColor="#38BDF8"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Spacer
            android:layout_width="match_parent"
            android:layout_height="4dp"/>

        <!-- Today Log Status -->
        <TextView
            android:id="@+id/widget_today_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Today: PENDING"
            android:textColor="#F1F5F9"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quick Add Shortcut Button -->
    <TextView
        android:id="@+id/widget_log_button"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:background="@drawable/widget_btn_bg"
        android:gravity="center"
        android:text="+ Log Today"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
